# Copiez ce fichier en .env.local pour le developpement. En production, ces variables se reglent
# dans Vercel > Settings > Environment Variables (puis redeploiement).

# Adresse de l'API backend (sans /api a la fin)
VITE_API_URL=http://localhost:3001

# Identifiant du site dans Umami Cloud (Settings > Websites > Edit). Vide : aucune mesure d'audience.
VITE_UMAMI_WEBSITE_ID=
